menu "iot-sad-zvuk"

    config IOT_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config IOT_WIFI_PASSWORD
        string "Wi-Fi пароль"
        default ""

    config IOT_MQTT_URI
        string "MQTT broker URI (пусто = MQTT выключен)"
        default "mqtt://5.183.191.188:31883"

    config IOT_MQTT_USERNAME
        string "MQTT логин"
        default "device"

    config IOT_MQTT_PASSWORD
        string "MQTT пароль"
        default ""

    config ZVUK_OTA_REPO
        string "GitHub-репозиторий для OTA (owner/repo, пусто = OTA выключен)"
        default "thefrol/iot-sad-zvuk"

    config ZVUK_OTA_CHECK_INTERVAL_MIN
        int "Интервал проверки обновлений, минут"
        default 60
        range 1 1440

endmenu
